{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UrlShortener": {
    "BaseUrl": "http://localhost:5000",
    "ShortCodeLength": 7,
    "MaxGenerationAttempts": 5,
    "DefaultLifetime": null
  },
  "Database": {
    "Provider": "Sqlite",
    "ApplyMigrationsOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  }
}
